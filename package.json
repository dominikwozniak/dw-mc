{
  "name": "dw-mc",
  "version": "0.0.0",
  "private": true,
  "description": "A local CLI that keeps the state of my open pull requests on disk, reads GitHub through gh, runs code reviews through local agent CLIs, and shows what every PR waits on.",
  "license": "MIT",
  "author": "Dominik Woźniak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dominikwozniak/dw-mc.git"
  },
  "type": "module",
  "bin": {
    "dw-mc": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "oxlint . --disable-nested-config",
    "lint:fix": "oxlint . --disable-nested-config --fix",
    "format": "dprint check",
    "format:fix": "dprint fmt",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "effect-tsgo patch --oxlint && husky"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.115",
    "dprint": "0.57.4",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
