{
  "extends": "./tsconfig.json",
  // `tools/` is checked here and nowhere else: `tsconfig.json` is the build, and a lint
  // plugin is not part of what `dist` ships. The vendored rules are excluded because they
  // are upstream's to typecheck, not this repository's.
  "include": ["src", "tools"],
  "exclude": ["tools/oxlint/anti-slop"],
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    // Widened from the build's `src`, which `tools/` is outside of. `noEmit` does not
    // relax the check: every file in the program still has to sit under it.
    "rootDir": "."
  }
}
